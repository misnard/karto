# /etc/karto/karto.env, read by karto-api.service and karto-relay.service.
# Holds secrets: `chown root:root` and `chmod 600` (systemd reads it as root).

# --- API (apps/api/node/server.ts) ---
HOST=127.0.0.1
PORT=8787
# SQLite database, created and migrated at startup.
KARTO_DB=/var/lib/karto/karto.sqlite
# cli: llm jobs wait for the relay (claude -p). api: the server calls the Anthropic API with ANTHROPIC_API_KEY.
LLM_RUNTIME=cli
LLM_MODEL=claude-haiku-5-5
#ANTHROPIC_API_KEY=
# Shared by the API and the relay. Generate it with: openssl rand -base64 32
RELAY_TOKEN=

# --- Relay (services/llm-relay) ---
KARTO_API_URL=http://127.0.0.1:8787
# When claude is not on the service PATH, e.g. installed for the karto user:
#CLAUDE_BIN=/var/lib/karto/.local/bin/claude
