{
  "manifest_version": 3,
  "name": "Karto",
  "version": "0.1.0",
  "description": "Transforme une liste de courses en panier Drive.",
  "permissions": ["storage", "scripting", "sidePanel", "alarms"],
  "host_permissions": ["https://www.carrefour.fr/*", "https://moncompte.carrefour.fr/*", "__API_ORIGIN__/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Karto" }
}
